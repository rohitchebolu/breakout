# YouTube Data API v3 key.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Enable "YouTube Data API v3" for your project.
# 3. Create an API key and paste it below.
#
# Without a key, the app runs in DEMO MODE with built-in sample data,
# so you can try the full experience before wiring up the real API.
YOUTUBE_API_KEY=

# Optional: Upstash Redis (Vercel Marketplace, free tier) for caching + per-IP
# rate limiting in production. Without these, the app uses an in-memory fallback
# — fine for local dev / a single instance, but not shared across serverless
# instances. Create a database in the Vercel Marketplace and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI breakdowns + trending topics. Configure ONE provider — first set wins, in
# order: Groq → NVIDIA → Vercel Gateway → Gemini. All are free/no-card except
# the Vercel Gateway. Without any key, these features degrade gracefully.

# Groq (recommended) — https://console.groq.com — free, no card, ~1s latency,
# reliable, good Telugu. Best fit for this app.
GROQ_API_KEY=
# Optional — override the model (default: llama-3.3-70b-versatile).
GROQ_MODEL=

# NVIDIA NIM — https://build.nvidia.com — free, no card, 40 req/min. Note: the
# large (70B) models are frequently overloaded on the free tier; fallback only.
NVIDIA_API_KEY=
# Optional — override the model (default: meta/llama-3.3-70b-instruct).
NVIDIA_MODEL=

# Google Gemini — https://aistudio.google.com/apikey — free but only ~20
# requests/day (all 2.5 models), so not suitable for the daily cron. Fallback only.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional — shared secret for the daily /api/cron/refresh-breakouts job.
# Set the SAME value in Vercel's env store; Vercel sends it as the Bearer token.
CRON_SECRET=
